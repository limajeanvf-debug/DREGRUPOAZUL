# Configurações do help desk quando montado no sistema principal.
# (Também podem ser passadas direto em criarHelpdesk({ banco: {...}, pastaUploads, urlPublica }))

# ---------- PostgreSQL ----------
# Pode ser o MESMO banco do sistema principal: as tabelas ficam no schema abaixo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario_do_banco
DB_PASSWORD=senha_do_banco
DB_NAME=nome_do_banco
DB_SCHEMA=helpdesk
# true só se o banco exigir SSL (bancos na nuvem)
DB_SSL=false
# Alternativa: DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ---------- Endereço público do help desk (links dos e-mails) ----------
APP_URL=https://sistema.azulviagensrec.com.br/helpdesk

# ---------- Anexos (prints) ----------
UPLOAD_DIR=./uploads

# ---------- E-mail automático (SMTP da Servhost) ----------
# Deixe SMTP_HOST vazio para desligar o envio automático.
SMTP_HOST=mail.azulviagensrec.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=helpdesk@azulviagensrec.com.br
SMTP_PASS=senha_do_email
MAIL_FROM="Help Desk Azul Viagens <helpdesk@azulviagensrec.com.br>"
